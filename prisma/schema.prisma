// The app runs on Cloudflare Workers, which cannot compile WASM at runtime, so it
// needs the precompiled workerd build.
generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
  runtime  = "workerd"
}

// Scripts (seed) run in Node, where the workerd build cannot load.
generator nodeClient {
  provider = "prisma-client"
  output   = "../src/generated/prisma-node"
}

datasource db {
  provider = "postgresql"
}

enum Category {
  press
  batching_plant
  mixture
}

enum ProductStatus {
  draft
  published
}

model Product {
  id                Int           @id @default(autoincrement())
  slug              String        @unique
  name              String
  category          Category
  tagline           String
  description       String
  images            Json          @default("[]")
  specs             Json?
  productionSummary Json?
  productionTable   Json?
  featureGroups     Json?
  additionalOutputs String[]
  outputCapacity    Int?
  power             String?
  dailyOutput       String?
  bestFor           String?
  featured          Boolean       @default(false)
  status            ProductStatus @default(draft)
  sortOrder         Int           @default(0)
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt

  @@index([status, sortOrder])
}

model Redirect {
  id        Int      @id @default(autoincrement())
  fromSlug  String   @unique
  toSlug    String
  createdAt DateTime @default(now())
}

model Lead {
  id        Int      @id @default(autoincrement())
  name      String
  company   String   @default("")
  phone     String
  email     String   @default("")
  location  String   @default("")
  product   String   @default("")
  output    String   @default("")
  message   String   @default("")
  handled   Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([handled, createdAt])
}
