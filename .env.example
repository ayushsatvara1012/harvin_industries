# Neon pooled connection (host contains -pooler). Used at runtime.
DATABASE_URL=
# Neon direct connection. Used by `prisma migrate` and the seed script.
DIRECT_URL=
# Cloudinary product images. The cloud name is public (inlined at build); the secret is server-only.
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=u2mb4lj7
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
# Admin login. Generate the hash with `npm run auth:hash`; AUTH_SECRET with `npx auth secret`.
AUTH_SECRET=
OWNER_EMAIL=
OWNER_PASSWORD_HASH=
# Public origin for metadata, sitemap and structured data. Allowed: https://harvinindustries.com,
# https://harvin-industries.vercel.app or http://localhost:<port>. Unset means the real domain
# (and localhost in `next dev`). Only the real domain is indexable.
NEXT_PUBLIC_SITE_URL=
