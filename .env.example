# Neon pooled connection (host contains -pooler). Used at runtime.
DATABASE_URL=
# Neon direct connection. Used by `prisma migrate` and the seed script.
DIRECT_URL=
# Cloudinary product images. The cloud name is public (inlined at build); the secret is server-only.
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=u2mb4lj7
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
# Admin login. Generate the hash with `npm run auth:hash`; AUTH_SECRET with `npx auth secret`.
AUTH_SECRET=
OWNER_EMAIL=
OWNER_PASSWORD_HASH=
# Lets the owner reset a forgotten password at /admin/forgot-password. Generate with
# `npm run auth:recovery-key`, hand it to the owner, and keep it out of the repo. A password
# the owner sets through the site is stored in the database and overrides OWNER_PASSWORD_HASH.
OWNER_RECOVERY_KEY=
# Public origin for metadata, sitemap and structured data. Allowed: https://harvinindustries.com,
# https://harvin-industries.vercel.app, the workers.dev host or http://localhost:<port>. Unset
# means the real domain (and localhost in `next dev`). Only the real domain is indexable, so
# set this to the workers.dev host for staging deploys and leave it empty at launch.
NEXT_PUBLIC_SITE_URL=
